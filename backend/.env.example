# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minimsaah?schema=public"

# JWT — generate a real secret: openssl rand -base64 32
JWT_SECRET="change-me"
JWT_EXPIRY="15m"
REFRESH_EXPIRY="7d"

# App
PORT=3000
CORS_ORIGIN="http://localhost:3001"
BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# R2 (Cloudflare) — persistent uploads on free tier (10GB)
# Get from dash.cloudflare.com → R2 → bucket minimsaah-media → Settings → Public URL
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="minimsaah-media"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"
