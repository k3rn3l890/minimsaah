{
  "name": "minimsaah",
  "version": "1.0.0",
  "description": "MINIMSAAH - Sports journalism platform for Ghana",
  "scripts": {
    "build": "npm run build:css && node scripts/inject-env.js && node scripts/sitemap.js",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "test": "node --test tests/smoke.mjs",
    "audit": "node scripts/audit-secrets.cjs",
    "verify": "node scripts/inject-env.js --verify",
    "backup:check": "node scripts/backup-restore.js --check",
    "dev": "npx vercel dev",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
